project_id                     = "example-project"
deployer_service_account_email = "github-tf-deploy@example-project.iam.gserviceaccount.com"
rebuild_impersonator_member    = "user:operator@example.com"
alert_email                    = "operator@example.com"
fitbit_subject_key             = "owner"

region    = "us-west1"
runtime_image_uri = "us-west1-docker.pkg.dev/example-project/personal-data-platform/runtime@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Replace these pins with registered numeric secret versions.
secret_versions = {
  motherduck_token      = "1"
  fitbit_oauth_config   = "1"
  fitbit_webhook_config = "1"
  heartbeat_config     = "1"
  owntracks_config     = "1"
}
schedulers_enabled           = true
motherduck_database           = "personal_data_platform"
preflight_motherduck_database = "personal_data_platform_west_preflight"
# Preserve existing _Default sink exclusions.
logging_exclusions = {}
